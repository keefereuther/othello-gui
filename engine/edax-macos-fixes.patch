 /**
@@ -298,11 +299,17 @@ static void* posix_function(void *arg) {
  */
 int thrd_create (thrd_t *thread, thrd_start_t function, void *arg)
 {
-	C11Function c11_func;
-	c11_func.function = function;
-	c11_func.arg = arg;
-
-	return pthread_create(thread, NULL, posix_function, &c11_func);
+	// heap-allocated: a stack local would be gone before the new thread reads it
+	C11Function *c11_func = (C11Function*) malloc(sizeof (C11Function));
+	if (c11_func == NULL) return thrd_nomem;
+	c11_func->function = function;
+	c11_func->arg = arg;
+
+	if (pthread_create(thread, NULL, posix_function, c11_func) != 0) {
+		free(c11_func);
+		return thrd_error;
+	}
+	return thrd_success;
 }
 
 /**
@@ -323,7 +330,10 @@ int thrd_detach(thrd_t thread) {
  * @return thrd_success on success an error otherwise.
  */
 int thrd_join(thrd_t thread, int *res) {
-	return pthread_join(thread, (void **) &res);
+	void *ret = NULL;
+	if (pthread_join(thread, &ret) != 0) return thrd_error;
+	if (res) *res = (int) (intptr_t) ret;
+	return thrd_success;
 }
 
